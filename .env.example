# CurriculumPilot — single configuration file.
# Copy to `.env` in this directory (same folder as api_service.py). The app loads `.env`
# on startup; variables already exported in your shell win over this file.
#
# Passwords or values containing # must be quoted, e.g. CURRICULUMPILOT_ADMIN_PASSWORD='x#y'

# --- Admin console (/admin/) — set a password to enable ---
CURRICULUMPILOT_ADMIN_PASSWORD=
# Optional alias if the line above is empty:
# ADMIN_PASSWORD=

# Optional extra step for /admin/login (set BOTH or neither). Answer compared case-insensitively.
ADMIN_SECURITY_QUESTION=
ADMIN_SECURITY_ANSWER=

# Session cookie signing (use a long random string in production)
ADMIN_SESSION_SECRET=
# Cookie max-age in seconds (default 28800 = 8 hours)
ADMIN_SESSION_MAX_AGE=28800
# Set true when the API is only served over HTTPS
ADMIN_SESSION_HTTPS_ONLY=false

# --- Require Bearer subscription key on POST /generate-course ---
SUBSCRIPTION_REQUIRED=false
# Default access-key lifetime in days when admin leaves “expires on” blank (create form)
SUBSCRIPTION_KEY_DEFAULT_VALIDITY_DAYS=365

# --- Multipart upload cap for TOC + book (megabytes per part) ---
BOOKCOURSE_MAX_PART_MB=512

# --- OpenAI-compatible LLM (defaults match local Ollama) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:14b
